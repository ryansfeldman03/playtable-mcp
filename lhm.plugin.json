{
  "author": "Rowhouse Software",
  "cloudEndpoint": "https://play.rowhousesoftware.com/mcp",
  "description": "Remote MCP server to make up any game and play it in chat with an AI agent or friends: board, card, dice and guessing games, with a fair table that deals, hides cards and rolls the dice.",
  "homepage": "https://play.rowhousesoftware.com",
  "identifier": "playtable-mcp",
  "name": "Playtable",
  "prompts": [],
  "resources": [
    {
      "name": "playtable_board",
      "title": "Game board",
      "uri": "ui://playtable/board.html",
      "description": "The interactive game board.",
      "mimeType": "text/html;profile=mcp-app"
    }
  ],
  "tools": [
    {
      "name": "create_game",
      "title": "Create a game",
      "description": "Set up any game to play in this chat: board games, card games, dice games, word and guessing games, mysteries. Describe it with the building blocks below, or pass starter for a ready one (tic-tac-toe, four-in-a-row, gomoku, checkers, reversi, crazy-eights, go-fish, twenty-one, pig, sea-battle, hangman, twenty-questions). The server keeps the board, deals and hides cards, rolls dice and enforces turns, so the player can trust the game. The player gets an interactive board in the chat (and a link to play in a browser or invite friends). Returns game_id and agent_key; keep both for get_state and take_turn. You run the rules that aren't built in.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "starter": {
            "type": "string",
            "enum": [
              "tic-tac-toe",
              "four-in-a-row",
              "gomoku",
              "checkers",
              "reversi",
              "crazy-eights",
              "go-fish",
              "twenty-one",
              "pig",
              "sea-battle",
              "hangman",
              "twenty-questions"
            ],
            "description": "A ready-made game. Other fields here override its setup (for example seats)."
          },
          "title": {
            "type": "string"
          },
          "about": {
            "type": "string",
            "description": "The rules in a few sentences, shown to the player. Write them so you can follow them too."
          },
          "seats": {
            "type": "array",
            "maxItems": 8,
            "description": "Players in turn order. Default: Player (human) then Agent (agent).",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "human",
                    "agent"
                  ]
                },
                "color": {
                  "type": "string"
                },
                "piece": {
                  "type": "object",
                  "description": "What a click on an empty cell places for this seat.",
                  "properties": {
                    "label": {
                      "type": "string"
                    },
                    "shape": {
                      "type": "string",
                      "enum": [
                        "disc",
                        "square",
                        "ring",
                        "star",
                        "diamond"
                      ]
                    },
                    "color": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "turns": {
            "type": "string",
            "enum": [
              "alternate",
              "free"
            ],
            "description": "alternate (default): one seat at a time. free: anyone acts anytime (guessing games, puzzles)."
          },
          "first": {
            "type": "string",
            "description": "Seat name that goes first."
          },
          "board": {
            "type": "object",
            "properties": {
              "rows": {
                "type": "integer",
                "maximum": 26
              },
              "cols": {
                "type": "integer",
                "maximum": 26
              },
              "pattern": {
                "type": "string",
                "enum": [
                  "plain",
                  "checker",
                  "lines"
                ]
              },
              "coords": {
                "type": "boolean"
              },
              "cells": {
                "type": "object",
                "additionalProperties": true,
                "description": "Starting cell marks: {\"B2\": {\"color\": \"#cde2fb\", \"label\": \"?\"}}"
              }
            }
          },
          "pieces": {
            "type": "array",
            "description": "Starting pieces.",
            "items": {
              "type": "object",
              "properties": {
                "at": {
                  "type": "string"
                },
                "owner": {
                  "type": "string",
                  "description": "Seat name, or omit for neutral."
                },
                "label": {
                  "type": "string"
                },
                "kind": {
                  "type": "string"
                },
                "shape": {
                  "type": "string"
                },
                "color": {
                  "type": "string"
                }
              }
            }
          },
          "deck": {
            "description": "\"standard\" (52, ids like AS, 10H, QC), \"standard_jokers\", \"numbers:1-10x4\", or a list of card labels or {label, suit, rank}. Adds a face-down deck, a face-up table and a hidden hand per seat.",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "object"
                    }
                  ]
                }
              }
            ]
          },
          "deal": {
            "type": "integer",
            "description": "Cards dealt to each hand at the start."
          },
          "piles": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "face": {
                  "type": "string",
                  "enum": [
                    "up",
                    "down",
                    "top",
                    "owner"
                  ]
                },
                "owner": {
                  "type": "string"
                }
              }
            }
          },
          "counters": {
            "type": "array",
            "description": "Scores and tallies: \"score\", or {name, per_seat: false, start}.",
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "object"
                }
              ]
            }
          },
          "dice": {
            "type": "integer",
            "description": "Default die sides."
          },
          "rules": {
            "type": "object",
            "description": "Rules the server enforces for you.",
            "properties": {
              "place": {
                "type": "string",
                "enum": [
                  "empty",
                  "any"
                ]
              },
              "gravity": {
                "type": "boolean"
              },
              "win_line": {
                "type": "integer",
                "description": "n in a row wins."
              },
              "one_move": {
                "type": "boolean",
                "description": "A place, move or play ends the turn by itself."
              },
              "max_hand": {
                "type": "integer"
              }
            }
          }
        }
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false
      },
      "_meta": {
        "ui": {
          "resourceUri": "ui://playtable/board.html"
        },
        "openai/outputTemplate": "ui://playtable/board.html",
        "openai/toolInvocation/invoking": "Setting up the table",
        "openai/toolInvocation/invoked": "Table ready"
      }
    },
    {
      "name": "get_state",
      "title": "See the game",
      "description": "What your seat can see now: the board, your hand, public piles, scores, dice, secrets you hold and the recent log. Call it when the player says they've moved or it might be your turn.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "game_id": {
            "type": "string"
          },
          "agent_key": {
            "type": "string"
          },
          "as": {
            "type": "string",
            "description": "Which of your seats, when you play more than one."
          }
        },
        "required": [
          "game_id",
          "agent_key"
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "take_turn",
      "title": "Make moves",
      "description": "Apply one or more actions for your seat, all or nothing: if any action is illegal, none happen and you get the reason. Usually end with end_turn. Action types and fields:\n- place {at: \"B3\"} or {column: \"D\"} with gravity; optional label, shape (disc, square, ring, star, diamond), color, kind, owner\n- move {from: \"B3\", to: \"C4\"} or {piece, to}; moving onto another player's piece takes it; optional label, kind\n- edit {at, owner?, label?, kind?, shape?, color?}: change a piece in place (flip, crown)\n- remove {at} or {piece}\n- mark {at, color?, label?}: paint or label a cell (hits, misses, letters)\n- draw {from?: \"deck\", to?: \"hand\", count?}\n- play {card, to?: \"table\", from?}: a card you can see, by id or label\n- give {card, to: seat}\n- shuffle {pile?}, collect {into?: \"deck\", from?: [piles]}: gather and reshuffle\n- roll {dice?: \"2d6\"}, pick {options: [...]}: server randomness, logged\n- score {counter?, seat?, add? | set?}\n- secret {name, value}: lock in hidden info (the word, the culprit, your fleet); reveal {name}\n- say {text}, end_turn {next?}, end_game {winner?, reason}, concede\nCells are column letter + row number from the top: A1 is the top left.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "game_id": {
            "type": "string"
          },
          "agent_key": {
            "type": "string"
          },
          "as": {
            "type": "string"
          },
          "actions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 40,
            "items": {
              "type": "object",
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            }
          }
        },
        "required": [
          "game_id",
          "agent_key",
          "actions"
        ]
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "show_board",
      "title": "Show the board",
      "description": "Show the interactive board in the chat again, for example after a long conversation or when the player asks to see it.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "game_id": {
            "type": "string"
          },
          "agent_key": {
            "type": "string"
          }
        },
        "required": [
          "game_id",
          "agent_key"
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "openWorldHint": false
      },
      "_meta": {
        "ui": {
          "resourceUri": "ui://playtable/board.html"
        },
        "openai/outputTemplate": "ui://playtable/board.html",
        "openai/toolInvocation/invoking": "Setting up the table",
        "openai/toolInvocation/invoked": "Table ready"
      }
    }
  ],
  "version": "1.0.0",
  "category": "lifestyle",
  "tags": [
    "games",
    "board games",
    "card games",
    "dice",
    "multiplayer",
    "mcp apps",
    "fun"
  ],
  "icon": "🎲",
  "authorUrl": "https://rowhousesoftware.com"
}
